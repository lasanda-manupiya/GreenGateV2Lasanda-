# -----------------------------
# SustainGate backend (OpenAI)
# Copy this file to `.env` for local use and fill in OPENAI_API_KEY.
# For Railway, add the same keys in the service Variables tab.
# -----------------------------

# Database — Railway injects this automatically when Postgres is attached.
DATABASE_URL=sqlite+aiosqlite:///./sustaingate.db

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM provider selection
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4.1-mini

# Anthropic (optional fallback if you switch provider)
ANTHROPIC_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,https://sustaingate.vercel.app

# Logging
LOG_LEVEL=INFO

# Storage
STORAGE_PATH=./storage

# Seed data on startup
SEED_ON_STARTUP=true

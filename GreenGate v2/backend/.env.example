# Database — Railway injects this automatically when you attach a Postgres plugin.
# Local dev uses SQLite by default. Railway-style postgres:// URLs are auto-normalized
# to postgresql+asyncpg:// by app/config.py.
DATABASE_URL=sqlite+aiosqlite:///./sustaingate.db

# Redis (optional — not required for core functionality)
REDIS_URL=redis://localhost:6379/0

# JWT — generate a strong random secret for production.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic — required for agents that call Claude (Strategy Builder, Report Writer, etc.)
ANTHROPIC_API_KEY=

# CORS — comma-separated list of exact allowed origins.
# The Vercel *.vercel.app regex is added automatically in app/main.py, so preview deploys
# work without reconfiguration. Add your production Vercel domain here.
CORS_ORIGINS=http://localhost:5173,https://sustaingate.vercel.app

# Logging
LOG_LEVEL=INFO

# Storage (evidence packs, uploads, etc.)
STORAGE_PATH=./storage

# Seed data on startup. Keep true for demo/local. In production, set to false
# after the first deploy — otherwise seeds re-run on every container restart.
SEED_ON_STARTUP=true
